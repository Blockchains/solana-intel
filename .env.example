# Copy to .env and fill only values you are authorised to use.
# Never commit real secrets. Synthetic mode needs none of these.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
OPERATING_MODE=synthetic
# synthetic | replay | live
# Live mode refuses to fall back to synthetic observations.

DATABASE_URL=
# Empty uses SQLite (synthetic/dev). Production example:
# postgres://solana:solana@postgres:5432/solana_intel

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Solana / market data. Leave blank to keep adapters fixture-only.
SOLANA_RPC_URL=
HELIUS_API_KEY=
DEXSCREENER_BASE_URL=https://api.dexscreener.com
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Telegram Bot API. A bot only sees chats it has been added to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# X official API. Coverage is limited to authorised access.
X_BEARER_TOKEN=

# OpenAI. Absent key forces the non-LLM fallback extractor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_DAILY_BUDGET_USD=2.00

# Risk profile. "Small" is initial_allocation_pct of portfolio_reference_value.
PORTFOLIO_REFERENCE_VALUE=
MAX_POSITION_PCT=2.0
AGGREGATE_EXPOSURE_PCT=8.0
INITIAL_ALLOCATION_PCT=0.5
MAX_ADDS=1
MAX_PRICE_IMPACT_PCT=3.0
QUOTE_MAX_AGE_SECONDS=90
MIN_LIQUIDITY_USD=8000
